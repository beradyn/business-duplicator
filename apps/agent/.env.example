# Use a WSS endpoint on your hosted backend, e.g. wss://example.com/agent
AGENT_SERVER_URL=wss://your-host.example/agent
# Generate a long random secret; set the same secret in the hosted backend.
AGENT_TOKEN=replace-with-long-random-secret
# Optional override; default resolves to the existing MCP build in this repository.
# MCP_ENTRY=/absolute/path/to/dist/index.js
