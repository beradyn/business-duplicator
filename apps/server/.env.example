PORT=3001
# Must be the exact HTTPS origin of your hosted web app
WEB_ORIGIN=https://your-site.example
# 32+ random bytes, base64 encoded; use a different secret for each variable
SESSION_SECRET=replace-with-long-random-secret
AGENT_TOKEN=replace-with-another-long-random-secret
# A bcrypt/scrypt password store is preferable; initial prototype uses scrypt hash
OWNER_PASSWORD_SALT=replace-with-random-hex-salt
OWNER_PASSWORD_HASH=replace-with-scrypt-derived-hex-hash
OPENAI_API_KEY=your-server-side-openai-key
OPENAI_MODEL=gpt-4.1-mini
